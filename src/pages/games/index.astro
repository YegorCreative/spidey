---
import CityArt from "../../components/art/CityArt.astro";
import WebArt from "../../components/art/WebArt.astro";
import GameCard from "../../components/games/GameCard.astro";
import { getCatalog, hrefFor } from "../../lib/catalog";
import type { GameCategory } from "../../lib/types";
import Base from "../../layouts/Base.astro";
import "../../styles/films.css";
import "../../styles/games.css";

const catalog = getCatalog();

function lookFor(categories: GameCategory[]): "classic" | "tie" | "insomniac" | "multi" | "mobile" {
  if (categories.includes("insomniac")) return "insomniac";
  if (categories.includes("multiverse")) return "multi";
  if (categories.includes("classic")) return "classic";
  if (categories.includes("mobile")) return "mobile";
  return "tie";
}

const games = catalog.games.map((game) => ({
  href: hrefFor("game", game.id),
  year: game.year,
  title: game.title,
  developer: game.developerIds.map((id) => catalog.creator(id).name).join(", "),
  developerIds: game.developerIds,
  platform: game.platforms.slice(0, 3).join(" · "),
  summary: game.tagline,
  look: lookFor(game.categories),
  poster: game.media?.poster ?? game.image,
  categories: game.categories.join("|"),
}));
const years = [...new Set(games.map((game) => game.year))].sort((a, b) => a - b);
const developerIds = [...new Set(games.flatMap((game) => game.developerIds))].sort((a, b) =>
  catalog.creator(a).name.localeCompare(catalog.creator(b).name),
);
const categories = [
  ["classic", "Classic"],
  ["movie-tie-in", "Movie tie-in"],
  ["open-world", "Open world"],
  ["insomniac", "Insomniac"],
  ["multiverse", "Multiverse"],
  ["mobile", "Mobile"],
] as const;
---
<Base title="Games — Spidey" description="Spider-Man video games from the 1982 Atari release through Marvel’s Spider-Man 2.">
  <div class="films games-page">
    <div class="films__atmo" aria-hidden="true">
      <CityArt variant="night" layer="far" />
      <WebArt variant="subtle" />
    </div>
    <header class="films-hero" data-parallax data-parallax-pointer>
      <div class="films-hero__sky" data-depth style="--depth: 0.16; --scroll-depth: 0.03" aria-hidden="true"></div>
      <p class="films-hero__ghost" data-depth style="--depth: 0.2; --scroll-depth: 0.04" aria-hidden="true">Games</p>
      <div class="films-hero__city films-hero__city--near" data-depth style="--depth: 0.7; --scroll-depth: 0.09" aria-hidden="true">
        <CityArt variant="night" layer="near" />
      </div>
      <div class="films-hero__copy">
        <p class="kicker">Archive</p>
        <h1 class="display-title">Games</h1>
        <p class="lede">A chronological shelf of Spider-Man games. Covers here are original archive art. A licensed image is used only when the record can name its source, credit, and permission.</p>
      </div>
    </header>
    <div data-filter-root>
      <form class="filters" aria-label="Filter games">
        <label>Year <select data-filter="year"><option value="all">All years</option>{years.map((year) => <option value={String(year)}>{year}</option>)}</select></label>
        <label>Developer <select data-filter="developer"><option value="all">All developers</option>{developerIds.map((id) => <option value={id}>{catalog.creator(id).name}</option>)}</select></label>
        <label>Category <select data-filter="category"><option value="all">All categories</option>{categories.map(([value, label]) => <option value={value}>{label}</option>)}</select></label>
      </form>
      <ul class="films-grid">
        {games.map((game, index) => (
          <li data-filter-item data-year={String(game.year)} data-developer={game.developerIds.join("|")} data-category={game.categories}>
            <GameCard href={game.href} year={game.year} title={game.title} developer={game.developer} platform={game.platform} summary={game.summary} look={game.look} poster={game.poster} delay={`${(index % 3) * 70}ms`} />
          </li>
        ))}
      </ul>
      <p class="search-empty" data-filter-empty hidden>No games match those filters.</p>
    </div>
  </div>
</Base>
