---
import TimelineList from "../../components/TimelineList.astro";
import Base from "../../layouts/Base.astro";
---
<Base title="Timeline — Spidey" description="A preview timeline of Spider-Man history from 1962 to Across the Spider-Verse.">
  <section class="page-hero">
    <p class="kicker">History</p>
    <h1>Timeline</h1>
    <p class="lede">
      A first line through Spider-Man’s public history. The same event shape can hold hundreds of moments later — games, arcs, and the issues in between.
    </p>
  </section>
  <div class="timeline-page">
    <TimelineList mode="full" />
  </div>
</Base>
