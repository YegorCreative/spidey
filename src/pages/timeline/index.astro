---
import Atmosphere from "../../components/Atmosphere.astro";
import TimelineList from "../../components/TimelineList.astro";
import Base from "../../layouts/Base.astro";
---
<Base title="Timeline — Spidey" description="Spider-Man history from 1962 onward, across comics, films, series, games, and character debuts.">
  <div class="band" data-parallax>
    <Atmosphere word="History" web />
    <section class="page-hero">
      <p class="kicker">History</p>
      <h1 class="display-title">Timeline</h1>
      <p class="lede">
        Comics, films, television, games, and debuts from 1962 onward. Era titles are markers, not walls. Filter the line without leaving the page. The homepage keeps a short preview so the full list can grow.
      </p>
    </section>
    <div class="timeline-page">
      <TimelineList mode="full" />
    </div>
  </div>
</Base>
