---
import Atmosphere from "../../components/Atmosphere.astro";
import TimelineList from "../../components/TimelineList.astro";
import Base from "../../layouts/Base.astro";
---
<Base title="Timeline — Spidey" description="A preview timeline of Spider-Man history from 1962 to Across the Spider-Verse.">
  <div class="band" data-parallax>
    <Atmosphere word="History" web />
    <section class="page-hero">
      <p class="kicker">History</p>
      <h1 class="display-title">Timeline</h1>
      <p class="lede">
        A first line through Spider-Man’s public history. Era titles are storytelling markers. One chapter keeps going when the next begins. The same event shape can hold hundreds of moments later — games, arcs, and the issues in between.
      </p>
    </section>
    <div class="timeline-page">
      <TimelineList mode="full" />
    </div>
  </div>
</Base>
