---
import { exploreItems } from "../config/curation";
import { href } from "../lib/paths";
import Atmosphere from "./Atmosphere.astro";
import Icon from "./Icon.astro";
---
<div class="band" data-parallax>
  <Atmosphere word="Archive" web />
  <section class="section" id="explore" aria-labelledby="explore-title">
  <div class="section__head" data-reveal>
    <p class="kicker">01 — The map</p>
    <h2 id="explore-title" class="display-title"><span>Explore the</span><span>Spider-Verse</span></h2>
  </div>
  <ul class="explore-grid">
    {exploreItems.map((item, index) => (
      <li class:list={[{ "is-wide": item.title === "Movies", "is-full": item.title === "Timeline" }]}>
        <a class:list={["explore-card", "panel", `accent-${item.accent}`]} href={href(item.href)} data-reveal style={`--delay: ${(index % 4) * 70}ms`}>
          <span class="explore-card__icon"><Icon name={item.icon} /></span>
          <span class="explore-card__title">{item.title}</span>
          <span class="explore-card__text">{item.description}</span>
        </a>
      </li>
    ))}
  </ul>
  </section>
</div>
