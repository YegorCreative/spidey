---
import type { ArchiveCard } from "../lib/cards";
import { href } from "../lib/paths";
import ArchiveCover from "./art/ArchiveCover.astro";
import EraMark from "./art/EraMark.astro";
import UniverseScene from "./art/UniverseScene.astro";
import VillainMark from "./art/VillainMark.astro";
import Atmosphere from "./Atmosphere.astro";

interface Props {
  kicker: string;
  title: string;
  lede: string;
  cards: ArchiveCard[];
}
const { kicker, title, lede, cards } = Astro.props;
---
<div class="band" data-parallax>
  <Atmosphere word={title} tone="blue" web />
  <section class="page-hero">
    <p class="kicker">{kicker}</p>
    <h1 class="display-title">{title}</h1>
    <p class="lede">{lede}</p>
  </section>
<ul class="archive-grid">
  {cards.map((card, index) => (
    <li>
      <a class:list={["archive-card", "panel", `accent-${card.accent}`]} href={card.href} data-reveal style={`--delay: ${(index % 4) * 60}ms`}>
        {!card.image && card.cover && (
          <span class="card-art"><ArchiveCover title={card.cover.title} issue={card.cover.issue} year={card.cover.year} tone={card.cover.tone} /></span>
        )}
        {!card.image && !card.cover && card.era && (
          <span class="card-art"><EraMark era={card.era} /></span>
        )}
        {!card.image && !card.cover && !card.era && card.sigil && (
          <span class="card-art"><VillainMark id={card.sigil} /></span>
        )}
        {!card.image && !card.cover && !card.era && !card.sigil && card.world && (
          <span class="card-art"><UniverseScene id={card.world} /></span>
        )}
        {card.image && (
          <img
            class="archive-card__image"
            src={href(card.image.src)}
            alt={card.image.alt}
            width={card.image.width}
            height={card.image.height}
            loading="lazy"
            decoding="async"
          />
        )}
        <span class="archive-card__eyebrow">{card.eyebrow}</span>
        <span class="archive-card__title">{card.title}</span>
        {card.meta && <span class="archive-card__meta">{card.meta}</span>}
        <span class="archive-card__summary">{card.summary}</span>
      </a>
    </li>
  ))}
</ul>
</div>
