---
import CityArt from "./art/CityArt.astro";
import Swinger from "./art/Swinger.astro";
import WebArt from "./art/WebArt.astro";
import { getCatalog, hrefFor } from "../lib/catalog";
import { href } from "../lib/paths";

const catalog = getCatalog();
const plates = [
  catalog.comic("amazing-fantasy-15"),
  catalog.movie("spider-man-2002"),
  catalog.movie("into-the-spider-verse"),
  catalog.movie("across-the-spider-verse"),
].map((entry) => {
  if ("issue" in entry) {
    return {
      href: hrefFor("comic", entry.id),
      year: String(entry.year),
      kicker: "Comic",
      title: `${entry.title} ${entry.issue}`,
    };
  }
  return {
    href: hrefFor("movie", entry.id),
    year: String(entry.year),
    kicker: "Film",
    title: entry.title,
  };
});
---
<section class="hero hero--scene" data-parallax data-parallax-pointer aria-labelledby="hero-title">
  <div class="hero__sky" data-depth style="--depth: 0.08" aria-hidden="true"></div>
  <div class="hero__layer hero__layer--far" data-depth style="--depth: 0.12" aria-hidden="true">
    <CityArt variant="night" layer="far" />
  </div>
  <div class="hero__layer hero__layer--mid" data-depth style="--depth: 0.24" aria-hidden="true">
    <CityArt variant="night" layer="mid" />
  </div>
  <div class="hero__haze" data-depth style="--depth: 0.3" aria-hidden="true"><div class="hero__haze-drift"></div></div>
  <p class="hero__ghost" data-depth style="--depth: 0.16" aria-hidden="true">The Spider-Verse</p>
  <div class="hero__web" data-depth style="--depth: 0.38" aria-hidden="true">
    <WebArt variant="broken" />
  </div>
  <div class="hero__halftone" data-depth style="--depth: 0.2" aria-hidden="true"></div>
  <div class="hero__swinger" data-depth style="--depth: 0.62" aria-hidden="true">
    <Swinger />
  </div>
  <div class="hero__layout">
    <div class="hero__copy">
      <p class="kicker">Fan archive · Since 1962</p>
      <h1 id="hero-title" class="hero__title">
        <span>Everything</span>
        <span class="is-serif">Spider-Man.</span>
        <span>One place.</span>
      </h1>
      <p class="lede">
        Explore more than six decades of Spider-Man — from comics and television to movies, games, characters, villains, suits, creators, and the Spider-Verse.
      </p>
      <div class="hero__actions">
        <a class="btn btn--primary" href="#explore">Explore the Spider-Verse</a>
        <a class="btn btn--ghost" href={href("/timeline/")}>Start the Timeline</a>
      </div>
    </div>
    <ul class="hero__stack">
      {plates.map((plate) => (
        <li>
          <a class="plate" href={plate.href}>
            <span class="plate__year">{plate.year}</span>
            <span class="plate__kicker">{plate.kicker}</span>
            <span class="plate__title">{plate.title}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
  <div class="hero__layer hero__layer--near" data-depth style="--depth: 0.74" aria-hidden="true">
    <CityArt variant="night" layer="near" />
  </div>
  <div class="hero__fore" data-depth style="--depth: 0.84" aria-hidden="true">
    <WebArt variant="strand" />
  </div>
</section>
