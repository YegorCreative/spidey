---
import { getCatalog, hrefFor } from "../lib/catalog";
import { href } from "../lib/paths";

const catalog = getCatalog();
const plates = [
  catalog.comic("amazing-fantasy-15"),
  catalog.movie("spider-man-2002"),
  catalog.movie("into-the-spider-verse"),
  catalog.movie("across-the-spider-verse"),
].map((entry) => {
  if ("issue" in entry) {
    return {
      href: hrefFor("comic", entry.id),
      year: String(entry.year),
      kicker: "Comic",
      title: `${entry.title} ${entry.issue}`,
    };
  }
  return {
    href: hrefFor("movie", entry.id),
    year: String(entry.year),
    kicker: "Film",
    title: entry.title,
  };
});
---
<section class="hero" data-parallax data-parallax-pointer aria-labelledby="hero-title">
  <div class="hero__sky" data-depth style="--depth: 0.1" aria-hidden="true"></div>
  <div class="hero__city" data-depth style="--depth: 0.2" aria-hidden="true">
    <svg viewBox="0 0 1200 420" preserveAspectRatio="xMidYMax slice">
      <g fill="none" stroke="currentColor" stroke-width="1.4">
        <path d="M0 340h1200" />
        <path d="M40 340V210h70v130M140 340V150h46v190M210 340V240h90v100M330 340V120h38v220M390 340V180h80v160M500 340V90h52v250M570 340V200h64v140M660 340V140h40v200M730 340V230h110v110M870 340V160h48v180M940 340V70h36v270M1000 340V190h78v150M1100 340V130h60v210" />
        <path d="M40 210l35-28 35 28M330 120l19-24 19 24M500 90l26-30 26 30M940 70l18-22 18 22" />
      </g>
    </svg>
  </div>
  <p class="hero__ghost" data-depth style="--depth: 0.16" aria-hidden="true">The Spider-Verse</p>
  <div class="hero__web" data-depth style="--depth: 0.34" aria-hidden="true">
    <svg viewBox="0 0 800 800">
      <g fill="none" stroke="currentColor" stroke-width="1">
        <circle cx="640" cy="120" r="40" />
        <circle cx="640" cy="120" r="110" />
        <circle cx="640" cy="120" r="190" />
        <circle cx="640" cy="120" r="280" />
        <circle cx="640" cy="120" r="380" />
        <path d="M640 0v800M240 120h800M360 0l560 480M920 0 360 480" />
      </g>
    </svg>
  </div>
  <div class="hero__halftone" data-depth style="--depth: 0.26" aria-hidden="true"></div>
  <div class="hero__layout">
    <div class="hero__copy">
      <p class="kicker">Fan archive · Since 1962</p>
      <h1 id="hero-title" class="hero__title">
        <span>Everything</span>
        <span class="is-serif">Spider-Man.</span>
        <span>One place.</span>
      </h1>
      <p class="lede">
        Explore more than six decades of Spider-Man — from comics and television to movies, characters, villains, suits, creators, and the Spider-Verse.
      </p>
      <div class="hero__actions">
        <a class="btn btn--primary" href="#explore">Explore the Spider-Verse</a>
        <a class="btn btn--ghost" href={href("/timeline/")}>Start the Timeline</a>
      </div>
    </div>
    <ul class="hero__stack">
      {plates.map((plate) => (
        <li>
          <a class="plate" href={plate.href}>
            <span class="plate__year">{plate.year}</span>
            <span class="plate__kicker">{plate.kicker}</span>
            <span class="plate__title">{plate.title}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
  <div class="hero__fore" data-depth style="--depth: 0.7" aria-hidden="true">
    <svg viewBox="0 0 1200 280" preserveAspectRatio="none">
      <g fill="none" stroke="currentColor" stroke-width="1.2">
        <path d="M0 220 C 180 80, 260 40, 420 120" />
        <path d="M40 260 C 200 140, 300 90, 480 150" />
        <path d="M1200 40 C 980 20, 860 120, 760 200" />
        <path d="M1200 110 C 1000 90, 900 160, 800 230" />
      </g>
    </svg>
  </div>
</section>
