---
import { getCatalog, hrefFor } from "../lib/catalog";
import { href } from "../lib/paths";

const universes = getCatalog().universes;
---
<section class="section" aria-labelledby="verse-title">
  <div class="section__head section__head--split">
    <div>
      <p class="kicker">06 — Realities</p>
      <h2 id="verse-title">Across the Spider-Verse</h2>
      <p class="section__lede">
        Spider-Man is not one life. These realities are the shelves the rest of the archive sits on — comics, films, futures, and the animated multiverse.
      </p>
    </div>
    <a class="text-link" href={href("/universes/")}>All universes</a>
  </div>
  <ul class="verse-list">
    {universes.map((universe) => (
      <li>
        <a class:list={["verse-card", `accent-${universe.accent}`]} href={hrefFor("universe", universe.id)}>
          <span class="verse-card__code">{universe.designation}</span>
          <span class="verse-card__main">
            <span class="verse-card__name">{universe.name}</span>
            <span class="verse-card__text">{universe.summary}</span>
          </span>
          <span class="verse-card__medium">{universe.medium}</span>
        </a>
      </li>
    ))}
  </ul>
</section>
