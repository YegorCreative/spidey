---
interface Props {
  name: "film" | "book" | "tv" | "spider" | "mask" | "globe" | "suit" | "hourglass" | "search" | "menu" | "close";
}
const { name } = Astro.props;
---
<svg class="icon" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
  {name === "film" && (
    <g fill="none" stroke="currentColor" stroke-width="1.6">
      <rect x="5" y="7" width="22" height="18" rx="2" />
      <path d="M5 12h22M5 20h22M11 7v18M21 7v18" />
    </g>
  )}
  {name === "book" && (
    <g fill="none" stroke="currentColor" stroke-width="1.6">
      <path d="M7 6.5h8.5c2 1.4 3.2 1.4 5.2 0H16" />
      <path d="M8 6.5v19c2.2 1.2 4 1.2 8 .2 4 1 5.8 1 8-.2v-19" />
      <path d="M16 7.2v18.5" />
    </g>
  )}
  {name === "tv" && (
    <g fill="none" stroke="currentColor" stroke-width="1.6">
      <rect x="4" y="8" width="24" height="15" rx="2" />
      <path d="M12 26h8M16 8 12 4M16 8l4-4" />
    </g>
  )}
  {name === "spider" && (
    <g fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
      <circle cx="16" cy="16" r="2.2" fill="currentColor" stroke="none" />
      <path d="M16 6v4M16 22v4M6 16h4M22 16h4M8.5 8.5l2.8 2.8M20.7 20.7l2.8 2.8M23.5 8.5l-2.8 2.8M11.3 20.7 8.5 23.5" />
    </g>
  )}
  {name === "mask" && (
    <g fill="none" stroke="currentColor" stroke-width="1.6">
      <path d="M6 14c0-5 4-8 10-8s10 3 10 8c0 6-4 12-10 12S6 20 6 14Z" />
      <path d="M11 15.5c.8 1.4 1.8 2 2.6 2s1.8-.6 2.6-2M18.4 15.5c.8 1.4 1.8 2 2.6 2" />
    </g>
  )}
  {name === "globe" && (
    <g fill="none" stroke="currentColor" stroke-width="1.6">
      <circle cx="16" cy="16" r="10" />
      <path d="M6 16h20M16 6c2.8 2.6 4.2 6 4.2 10S18.8 23.4 16 26c-2.8-2.6-4.2-6-4.2-10S13.2 8.6 16 6Z" />
    </g>
  )}
  {name === "suit" && (
    <g fill="none" stroke="currentColor" stroke-width="1.6">
      <path d="M11 6.5 16 9l5-2.5 3 4-3 2v12.5H11V12.5l-3-2 3-4Z" />
      <path d="M13 16.5c1 .8 2 1.2 3 1.2s2-.4 3-1.2" />
    </g>
  )}
  {name === "hourglass" && (
    <g fill="none" stroke="currentColor" stroke-width="1.6">
      <path d="M10 6h12M10 26h12M11 6c0 5 5 6 5 10s-5 5-5 10M21 6c0 5-5 6-5 10s5 5 5 10" />
    </g>
  )}
  {name === "search" && (
    <g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
      <circle cx="14" cy="14" r="6.5" />
      <path d="m19 19 6 6" />
    </g>
  )}
  {name === "menu" && (
    <g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
      <path d="M7 10h18M7 16h18M7 22h12" />
    </g>
  )}
  {name === "close" && (
    <g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
      <path d="m9 9 14 14M23 9 9 23" />
    </g>
  )}
</svg>
