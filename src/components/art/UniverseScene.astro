---
import CityArt from "./CityArt.astro";

interface Props {
  id?: string;
}
const { id = "earth-616" } = Astro.props;
const city = id === "raimi"
  ? "sunset"
  : id === "webb" || id === "mcu"
    ? "night"
    : id === "earth-90214"
      ? "noir"
      : id === "earth-928"
        ? "future"
        : id === "spider-verse-animated" || id === "earth-65"
          ? "verse"
          : id === "ultimate"
            ? "canyon"
            : "night";
---
<div class:list={["world", `world--${id}`]} aria-hidden="true">
  {(id === "raimi" || id === "webb" || id === "mcu" || id === "earth-90214" || id === "earth-928" || id === "ultimate" || id === "insomniac" || !["earth-616", "spider-verse-animated", "earth-65"].includes(id)) && (
    <CityArt variant={city} layer="mid" />
  )}
  {id === "earth-616" && (
    <svg viewBox="0 0 320 140">
      <path d="M16 16h26M16 16v26M304 16h-26M304 16v26M16 124h26M16 124v-26" fill="none" stroke="currentColor" stroke-width="1.4" />
      <circle cx="168" cy="74" r="36" fill="none" stroke="currentColor" stroke-width="1.2" />
      <path d="M40 108c28-36 48-28 70 6M70 36c18 22 16 40-6 58M210 40c22 8 30 28 14 48" fill="none" stroke="currentColor" stroke-width="1.3" />
      <path d="M250 96c8 10 20 8 28-4" fill="none" stroke="currentColor" stroke-dasharray="2 4" />
    </svg>
  )}
  {id === "spider-verse-animated" && (
    <svg class="world__portal" viewBox="0 0 320 140">
      <circle class="portal__spin" cx="210" cy="70" r="42" fill="none" stroke="#ff4d6d" stroke-width="1.6" />
      <circle cx="224" cy="76" r="42" fill="none" stroke="#6ea2ff" stroke-width="1.4" />
      <circle cx="198" cy="64" r="24" fill="none" stroke="#f4f0e6" stroke-dasharray="3 5" />
    </svg>
  )}
  {id === "earth-65" && (
    <svg viewBox="0 0 320 140">
      <path d="M20 110c36-62 78-70 110-8" fill="none" stroke="#ff7eb6" stroke-width="3" />
      <path d="M90 96c20-30 48-28 62 4" fill="none" stroke="#f4f0e6" stroke-width="1.4" />
      <circle cx="230" cy="52" r="22" fill="#ff7eb6" opacity="0.55" />
      <circle cx="248" cy="64" r="14" fill="none" stroke="#f4f0e6" />
    </svg>
  )}
  <span class="world__grain"></span>
</div>
