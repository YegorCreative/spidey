---
import { previewTimelineIds } from "../config/curation";
import { getCatalog, hrefFor, timelineBucket } from "../lib/catalog";
import { href } from "../lib/paths";
import type { TimelineEvent } from "../lib/types";

interface Props {
  mode?: "preview" | "full";
}
const { mode = "full" } = Astro.props;
const catalog = getCatalog();
const previewIds = new Set<string>(previewTimelineIds);
const events = mode === "preview" ? catalog.timeline.filter((event) => previewIds.has(event.id)) : catalog.timeline;

const eras = [
  { year: 1962, title: "The Beginning", note: "1962+" },
  { year: 1967, title: "Spider-Man on Television", note: "1967+" },
  { year: 1977, title: "Live Action Emerges", note: "1977+" },
  { year: 2002, title: "The Raimi Era", note: "2002+" },
  { year: 2012, title: "The Amazing Era", note: "2012+" },
  { year: 2016, title: "The MCU Era", note: "2016+" },
  { year: 2018, title: "The Spider-Verse", note: "2018+" },
];

function labelFor(type: string, id: string): string {
  if (type === "movie") return catalog.movie(id).title;
  if (type === "series") return catalog.seriesById(id).title;
  if (type === "comic") {
    const comic = catalog.comic(id);
    return `${comic.title} ${comic.issue}`;
  }
  if (type === "actor") return catalog.actor(id).name;
  if (type === "character") return catalog.character(id).name;
  if (type === "villain") return catalog.villain(id).name;
  if (type === "universe") return catalog.universe(id).name;
  if (type === "suit") return catalog.suit(id).name;
  if (type === "creator") return catalog.creator(id).name;
  if (type === "game") return catalog.game(id).title;
  return catalog.event(id).title;
}

function kindLabel(kind: TimelineEvent["kind"]): string {
  if (kind === "comic") return "Comic";
  if (kind === "series" || kind === "animation") return "Series";
  if (kind === "movie" || kind === "spider-verse") return "Film";
  if (kind === "game") return "Game";
  if (kind === "character") return "Character";
  if (kind === "creator") return "Creator";
  return "Milestone";
}

const rows: Array<
  | { kind: "era"; year: number; title: string; note: string }
  | { kind: "event"; event: TimelineEvent; side: string; index: number }
> = [];
let nextEra = 0;
events.forEach((event, index) => {
  while (nextEra < eras.length && eras[nextEra].year <= event.year) {
    rows.push({ kind: "era", ...eras[nextEra] });
    nextEra += 1;
  }
  rows.push({
    kind: "event",
    event,
    side: index % 2 === 0 ? "is-left" : "is-right",
    index,
  });
});
---
{mode === "preview" ? (
  <div class="band band--red" data-parallax>
    <div class="atmo atmo--red" aria-hidden="true">
      <div class="atmo__glow" data-depth style="--depth: 0.12"></div>
      <p class="atmo__word" data-depth style="--depth: 0.15">1962</p>
    </div>
    <section class="section" aria-labelledby="years-title">
      <div class="section__head section__head--split" data-reveal>
        <div>
          <p class="kicker">03 — History</p>
          <h2 id="years-title" class="display-title"><span>Through</span><span>the Years</span></h2>
        </div>
        <a class="text-link" href={href("/timeline/")}>Open the full timeline</a>
      </div>
      <div class="thread thread--preview" data-parallax data-draw>
        <div class="thread__line" aria-hidden="true"><span class="thread__fill"></span></div>
        <ol class="thread__list">
          {rows.map((row) => row.kind === "era" ? (
            <li class="era era--compact" data-filter-era>
              <p class="kicker">Marker · {row.note}</p>
              <p class="era__title">{row.title}</p>
            </li>
          ) : (
            <li class="thread__item">
              <span class="thread__node" data-node aria-hidden="true"></span>
              <a
                class="artifact panel"
                data-reveal
                style={`--delay: ${(row.index % 4) * 60}ms`}
                href={row.event.refs[0] ? hrefFor(row.event.refs[0].type, row.event.refs[0].id) : href(`/timeline/#${row.event.id}`)}
              >
                <span class:list={["artifact__plate", "poster", "accent-red"]} aria-hidden="true">
                  <span class="poster__issue">{row.event.year}</span>
                  <span class="poster__name">{kindLabel(row.event.kind)}</span>
                </span>
                <span>
                  <span class="artifact__year">{row.event.year}</span>
                  <span class="artifact__title">{row.event.title}</span>
                  <span class="artifact__summary">{row.event.summary}</span>
                </span>
              </a>
            </li>
          ))}
        </ol>
      </div>
    </section>
  </div>
) : (
  <div data-filter-root>
    <div class="filters" role="toolbar" aria-label="Filter the timeline">
      {[
        ["all", "All events"],
        ["movies", "Movies"],
        ["comics", "Comics"],
        ["series", "Series"],
        ["games", "Games"],
        ["characters", "Characters"],
      ].map(([value, label]) => (
        <button type="button" data-filter="bucket" data-value={value} aria-pressed={value === "all" ? "true" : "false"}>{label}</button>
      ))}
    </div>
  <div class="thread thread--full" data-parallax data-draw>
    <div class="thread__line" aria-hidden="true"><span class="thread__fill"></span></div>
    <ol class="thread__list">
      {rows.map((row) => row.kind === "era" ? (
        <li class="era" data-filter-era>
          <div class="era__shift" data-depth style="--depth: 0.16">
            <p class="era__ghost" aria-hidden="true">{row.note}</p>
          </div>
          <p class="kicker">Marker · {row.note}</p>
          <h2 class="era__title">{row.title}</h2>
        </li>
      ) : (
        <li class:list={["thread__item", row.side]} id={row.event.id} data-filter-item data-bucket={timelineBucket(row.event.kind)}>
          <span class="thread__node" data-node aria-hidden="true"></span>
          <article class="artifact panel" data-reveal style={`--delay: ${(row.index % 4) * 60}ms`}>
            <span class:list={["artifact__plate", "poster", "accent-red"]} aria-hidden="true">
              <span class="poster__issue">{row.event.year}</span>
              <span class="poster__name">{kindLabel(row.event.kind)}</span>
            </span>
            <div>
              <p class="artifact__year">{row.event.year}</p>
              <h2 class="artifact__title">{row.event.title}</h2>
              <p class="artifact__summary">{row.event.summary}</p>
            </div>
            {row.event.refs.length > 0 && (
              <div class="artifact__links">
                <span class="artifact__label">Related records</span>
                <ul class="inline-links">
                  {row.event.refs.map((ref) => (
                    <li><a href={hrefFor(ref.type, ref.id)}>{labelFor(ref.type, ref.id)}</a></li>
                  ))}
                </ul>
              </div>
            )}
          </article>
        </li>
      ))}
    </ol>
    <p class="search-empty" data-filter-empty hidden>No events match that filter.</p>
  </div>
  </div>
)}
