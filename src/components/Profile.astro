---
import ArchiveCover from "./art/ArchiveCover.astro";
import UniverseScene from "./art/UniverseScene.astro";
import VillainMark from "./art/VillainMark.astro";
import WebArt from "./art/WebArt.astro";
import { getCatalog } from "../lib/catalog";
import { href } from "../lib/paths";
import type { MediaImage, MediaSet, ProfileModel } from "../lib/types";

interface Props {
  profile: ProfileModel;
  image?: MediaImage;
  media?: MediaSet;
  scene?: "city" | "cover" | "villain" | "web";
  sceneId?: string;
}
const { profile, image, media, scene, sceneId } = Astro.props;
const picture = media?.heroImage ?? media?.poster ?? media?.portrait ?? image;
const comic = scene === "cover" && sceneId ? getCatalog().comic(sceneId) : undefined;
---
<article class:list={["profile", "stage", `accent-${profile.accent}`]} data-parallax>
  <div class="stage__glow" data-depth style="--depth: 0.12" aria-hidden="true"></div>
  <p class="stage__ghost" data-depth style="--depth: 0.16" aria-hidden="true">{profile.kicker}</p>
  <div class="stage__web" data-depth style="--depth: 0.62" aria-hidden="true"><WebArt variant="radial" /></div>
  {scene === "villain" && sceneId && (
    <div class="stage__sigil" data-depth style="--depth: 0.28"><VillainMark id={sceneId} /></div>
  )}
  {scene === "city" && sceneId && (
    <div class="stage__world" data-depth style="--depth: 0.18"><UniverseScene id={sceneId} /></div>
  )}
  <nav class="crumbs" aria-label="Breadcrumb">
    <ol>
      {profile.crumbs.map((crumb, index) => (
        <li>
          {crumb.href && index < profile.crumbs.length - 1 ? (
            <a href={crumb.href}>{crumb.label}</a>
          ) : (
            <span aria-current="page">{crumb.label}</span>
          )}
        </li>
      ))}
    </ol>
  </nav>
  <div class="profile__layout">
    <header class="profile__intro">
      <p class="kicker">{profile.kicker}</p>
      <h1>{profile.title}</h1>
      {picture && (
        <img
          class="profile__image"
          src={href(picture.src)}
          alt={picture.alt}
          width={picture.width}
          height={picture.height}
          decoding="async"
        />
      )}
      <p class="lede">{profile.lede}</p>
    </header>
    {profile.facts.length > 0 && (
      <dl class="facts panel" data-reveal>
        {profile.facts.map((fact) => (
          <>
            <dt>{fact.label}</dt>
            <dd>{fact.value}</dd>
          </>
        ))}
      </dl>
    )}
    {profile.sources && profile.sources.length > 0 && (
      <section class="group" aria-labelledby="profile-sources">
        <h2 id="profile-sources">Sources</h2>
        <ul class="inline-links">
          {profile.sources.map((source) => (
            <li><a href={source.href} rel="noopener noreferrer">{source.label}</a></li>
          ))}
        </ul>
      </section>
    )}
    {comic && (
      <div class="stage__cover" data-depth style="--depth: 0.22">
        <ArchiveCover title={comic.title} issue={comic.issue} year={comic.year} tone={comic.id} />
      </div>
    )}
  </div>
  {profile.groups.length > 0 && (
    <div class="groups">
      {profile.groups.map((group) => (
        <section class="group" data-reveal aria-labelledby={`group-${group.title.replace(/\s+/g, "-").toLowerCase()}`}>
          <h2 id={`group-${group.title.replace(/\s+/g, "-").toLowerCase()}`}>{group.title}</h2>
          <ul>
            {group.links.map((link) => (
              <li>
                <a href={link.href}>
                  <span>{link.label}</span>
                  {link.meta && <span class="group__meta">{link.meta}</span>}
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  )}
</article>
