---
interface Props {
  id: string;
}

const { id } = Astro.props;

const kind =
  id === "spider-man-2002" ? "raimi"
  : id === "the-amazing-spider-man" ? "webb"
  : id === "spider-man-homecoming" ? "mcu"
  : id === "into-the-spider-verse" ? "into"
  : id === "spider-man-no-way-home" ? "nwh"
  : id === "across-the-spider-verse" ? "across"
  : "raimi";
---
<div class:list={["reel", `reel--${kind}`]} aria-hidden="true">
  <div class="reel__layer reel__sky" data-depth style="--depth: 0.22; --scroll-depth: 0.03"></div>

  {kind === "raimi" && (
    <>
      <svg class="reel__layer reel__draw" data-depth style="--depth: 0.38; --scroll-depth: 0.05" viewBox="0 0 600 900" preserveAspectRatio="xMidYMid slice">
        <path fill="#2a3348" d="M0 900V640h28V520h22v120h18V470h46v170h24V560h34v80h40V430h26v210h32V500h22v140h48V390h30v250h36V470h28v170h40V360h24v280h38V520h30v120h34V440H600V900Z" />
      </svg>
      <svg class="reel__layer reel__draw" data-depth style="--depth: 0.55; --scroll-depth: 0.07" viewBox="0 0 600 900" preserveAspectRatio="xMidYMid slice">
        <path fill="#141a28" d="M0 900V520h46V340h34v180h20V280h52v240h18V400h40v120h70V250h28v270h36V360h24v160h60V220h32v300h40V330h26v190h48V200H600V900Z" />
        <g fill="#f0c56a" opacity="0.85">
          <rect x="58" y="390" width="6" height="10" /><rect x="70" y="390" width="6" height="10" />
