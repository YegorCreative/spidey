      <div class="reel__layer reel__haze" data-depth style="--depth: 0.5; --scroll-depth: 0.06"><span></span></div>
      <svg class="reel__layer reel__draw" data-depth style="--depth: 0.78; --scroll-depth: 0.09" viewBox="0 0 600 900" preserveAspectRatio="xMidYMid slice">
        <g fill="none" stroke="#e7eef8" stroke-width="1.1">
          <path d="M300 40c8 120-30 180-10 280 14 70-20 120-8 200" />
          <path d="M250 80c20 90 8 140 24 220" opacity="0.65" />
          <path d="M360 120c-10 100 16 150-6 240" opacity="0.5" />
