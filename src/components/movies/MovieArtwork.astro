      </svg>
      <div class="reel__layer reel__haze" data-depth style="--depth: 0.46; --scroll-depth: 0.05"><span></span></div>
      <svg class="reel__layer reel__draw" data-depth style="--depth: 0.8; --scroll-depth: 0.09" viewBox="0 0 600 900" preserveAspectRatio="xMidYMid slice">
        <path d="M120 620c80-40 140-30 200 10" fill="none" stroke="#f4f0e6" stroke-width="1.3" opacity="0.8" />
        <path d="M80 40h16v28h28" fill="none" stroke="#f4f0e6" opacity="0.35" />
      </svg>
      <svg class="reel__layer reel__draw" data-depth style="--depth: 0.95; --scroll-depth: 0.11" viewBox="0 0 600 900" preserveAspectRatio="xMidYMid slice">
        <path fill="#120c10" d="M0 900V820h110V760h40v60H0zM600 900V800h-90V740h-36v80H600z" />
      </svg>
    </>
  )}

  {kind === "into" && (
    <>
      <div class="reel__layer reel__dots" data-depth style="--depth: 0.3; --scroll-depth: 0.04"></div>
