          <path d="M520 40C390 160 360 240 300 300" />
          <path d="M80 160c70 20 90 70 60 120" opacity="0.7" />
        </g>
        <g fill="#f4f0e6">
          <path d="M250 6c-18 70-46 110-28 168" fill="none" stroke="#f4f0e6" stroke-width="1.5" />
          <ellipse cx="214" cy="196" rx="14" ry="16" />
          <path d="M202 210c-8 40-6 78 4 112l16-2c-8-32-8-66 2-104z" />
          <path d="M206 314c-28 22-48 52-40 86l14-2c-4-26 12-48 34-66z" />
          <path d="M220 312c32 16 58 40 70 74l-14 6c-10-28-32-48-60-62z" />
          <rect x="204" y="192" width="20" height="4" fill="#141018" />
        </g>
      </svg>
      <svg class="reel__layer reel__draw" data-depth style="--depth: 0.95; --scroll-depth: 0.12" viewBox="0 0 600 900" preserveAspectRatio="xMidYMid slice">
        <path fill="#07080e" d="M0 900V640h70V470h40v170h26V560H0zM600 900V600h-64V430h-36v170h-28V520H600z" />
      </svg>
    </>
  )}

  {kind === "webb" && (
    <>
      <svg class="reel__layer reel__draw" data-depth style="--depth: 0.4; --scroll-depth: 0.05" viewBox="0 0 600 900" preserveAspectRatio="xMidYMid slice">
        <path fill="#16304f" d="M40 900V500h16V220h14v280h22V160h12v340h26V240h14v260h30V120h16v380h20V200h18v300h24V100h14v400h28V180h16v320h22V140h12v360h30V210H560V900Z" opacity="0.7" />
      </svg>
