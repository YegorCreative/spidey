        </g>
        <g stroke="#d5deea" stroke-width="1.2" opacity="0.35">
          <path d="M80 80l-14 36M140 120l-14 36M220 60l-14 36M300 140l-14 36M390 90l-14 36M480 150l-14 36" />
        </g>
      </svg>
      <div class="reel__layer reel__haze" data-depth style="--depth: 0.48; --scroll-depth: 0.06"><span></span></div>
      <svg class="reel__layer reel__draw" data-depth style="--depth: 0.72; --scroll-depth: 0.09" viewBox="0 0 600 900" preserveAspectRatio="xMidYMid slice">
