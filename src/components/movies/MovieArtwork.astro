        <circle cx="300" cy="430" r="70" fill="none" stroke="#f4f0e6" stroke-width="2" />
        <circle cx="318" cy="442" r="70" fill="none" stroke="#ff2f86" stroke-width="2" />
        <circle cx="286" cy="418" r="46" fill="none" stroke="#37d0ff" stroke-dasharray="4 6" />
      </svg>
    </>
  )}

  {kind === "nwh" && (
    <>
      <svg class="reel__layer reel__draw" data-depth style="--depth: 0.36; --scroll-depth: 0.045" viewBox="0 0 600 900" preserveAspectRatio="xMidYMid slice">
        <path fill="#1a2436" d="M0 900V620h36V500h24v120h20V460h40v160h18V520h30v100h50V420h22v200h28V480h20v140h46V390h24v230h30V500h26v120h40V440H600V900Z" />
      </svg>
      <svg class="reel__layer reel__draw" data-depth style="--depth: 0.55; --scroll-depth: 0.07" viewBox="0 0 600 900" preserveAspectRatio="xMidYMid slice">
