          <path d="M40 80h70M40 80v50" stroke-width="2" />
        </g>
      </svg>
      <svg class="reel__layer reel__draw" data-depth style="--depth: 0.84; --scroll-depth: 0.1" viewBox="0 0 600 900" preserveAspectRatio="xMidYMid slice">
