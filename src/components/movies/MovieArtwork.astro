          <rect x="48" y="560" width="28" height="280" />
          <rect x="110" y="470" width="22" height="340" />
          <rect x="176" y="400" width="34" height="390" />
          <rect x="250" y="510" width="18" height="300" />
          <rect x="320" y="360" width="30" height="420" />
