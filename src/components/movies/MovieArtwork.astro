        <circle cx="196" cy="252" r="110" fill="none" stroke="#3ec6ff" stroke-width="1.5" />
        <path fill="#ff7a3c" opacity="0.8" d="M120 360V250h16V200h12v50h14V180h18v70h16V220h14v30H120z" />
