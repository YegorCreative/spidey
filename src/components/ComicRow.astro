---
import { featuredComicIds } from "../config/curation";
import { getCatalog, hrefFor } from "../lib/catalog";
import { href } from "../lib/paths";
import Atmosphere from "./Atmosphere.astro";

const catalog = getCatalog();
const comics = featuredComicIds.map((id) => catalog.comic(id));
---
<div class="band" data-parallax>
  <Atmosphere word="Print" tone="blue" />
  <section class="section" aria-labelledby="comics-title">
  <div class="section__head section__head--split" data-reveal>
    <div>
      <p class="kicker">04 — Print</p>
      <h2 id="comics-title" class="display-title"><span>From the</span><span>Comics</span></h2>
      <p class="section__lede">
        Spider-Man begins on the page. These founding issues show the shape of a record: cover, title, issue, year, creators, universe, and story.
      </p>
    </div>
    <a class="text-link" href={href("/comics/")}>Browse comics</a>
  </div>
  <ul class="comic-grid">
    {comics.map((comic, index) => {
      const universe = catalog.universe(comic.universeId);
      const writers = comic.writerIds.map((id) => catalog.creator(id).name).join(", ");
      const artists = comic.artistIds.map((id) => catalog.creator(id).name).join(", ");
      return (
        <li>
          <a class="comic-card" href={hrefFor("comic", comic.id)} data-reveal style={`--delay: ${(index % 4) * 70}ms`}>
            <span class:list={["poster", `accent-${universe.accent}`]} aria-hidden="true">
              <span class="poster__issue">{comic.issue}</span>
              <span class="poster__name">{comic.title}</span>
              <span class="poster__year">{comic.year}</span>
            </span>
            <span class="comic-card__body">
              <span class="comic-card__title">{comic.title} {comic.issue}</span>
              <span class="comic-card__meta">{comic.year} · {universe.name}</span>
              <span class="comic-card__meta">Writer {writers}</span>
              <span class="comic-card__meta">Artist {artists}</span>
              <span class="comic-card__summary">{comic.summary}</span>
            </span>
          </a>
        </li>
      );
    })}
  </ul>
  </section>
</div>
